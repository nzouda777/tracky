# ---------------------------------------------------------------------------
# Environment for the local Docker stack (docker-compose.yml).
#
# DEVELOPMENT ONLY. These values are throwaway and are committed on purpose so
# the stack starts with no manual setup. Never reuse them anywhere real.
# ---------------------------------------------------------------------------

APP_URL="http://localhost:3000"
PLATFORM_NAME="Tracky (local)"

# --- Database --------------------------------------------------------------
# Host name is the compose service, reachable on the private network.
DATABASE_URL="postgres://tracky:tracky@postgres:5432/tracky"

# Routes @neondatabase/serverless at the local Neon HTTP proxy instead of
# Neon's cloud endpoint. Leave this UNSET in production.
NEON_HTTP_ENDPOINT="http://neon-proxy:4444/sql"

# --- Auth ------------------------------------------------------------------
AUTH_SECRET="2qNyrLQ8DmXXshLV/dcoeGRv+gePg9vF2PyvDhDX7z4="
AUTH_TRUST_HOST="true"

# --- Encryption at rest ----------------------------------------------------
ENCRYPTION_KEY="5qd2HQl/kv50RDlldlmTF8Ze8cg63BLabCyERa+a5iU="

# --- Shopify ---------------------------------------------------------------
# Placeholders: real OAuth and webhooks need a real app and a public tunnel.
SHOPIFY_API_KEY="local-dev-api-key"
SHOPIFY_API_SECRET="local-dev-api-secret"
SHOPIFY_SCOPES="read_orders,write_orders,read_fulfillments,write_fulfillments"
SHOPIFY_API_VERSION="2025-07"

# Lets the tracking page render without an App Proxy signature. Only has any
# effect in a non-production build; see lib/shopify/app-proxy.ts.
ALLOW_UNSIGNED_APP_PROXY="1"

# --- Cron ------------------------------------------------------------------
CRON_SECRET="local-dev-cron-secret"

# --- Not emulated locally --------------------------------------------------
# RESEND_*, QSTASH_* and BLOB_READ_WRITE_TOKEN are intentionally unset: the app
# degrades gracefully (emails are recorded as failed, uploads are refused)
# rather than crashing. Paste real keys here to exercise those paths.
