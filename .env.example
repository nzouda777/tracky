# ---------------------------------------------------------------------------
# Tracky — environment variables
# Copy to `.env.local` for local development; set the same keys in Vercel.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public origin of THIS app (no trailing slash). Used to build Shopify OAuth
# redirect URLs, webhook callback URLs and QStash job callbacks.
APP_URL="http://localhost:3000"

# Display name used in transactional emails when a store has no name yet.
PLATFORM_NAME="Tracky"

# --- Database (Neon Postgres, serverless driver) ----------------------------
# Neon connection string, pooled endpoint. Must include `sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Local Docker only. Points @neondatabase/serverless at the Neon HTTP proxy in
# docker-compose.yml instead of Neon's cloud endpoint. LEAVE UNSET in
# production and when using a real Neon database.
# NEON_HTTP_ENDPOINT="http://neon-proxy:4444/sql"

# Local development only. Renders the App Proxy tracking page without a
# Shopify signature. Ignored in production builds. LEAVE UNSET on any
# deployed environment.
# ALLOW_UNSIGNED_APP_PROXY="1"

# --- Auth.js (NextAuth) ----------------------------------------------------
# Secret used to sign/encrypt session cookies. Generate: `openssl rand -base64 32`
AUTH_SECRET="change-me-openssl-rand-base64-32"
# Set to `true` behind a proxy/Vercel so Auth.js trusts the forwarded host.
AUTH_TRUST_HOST="true"

# --- Encryption at rest ----------------------------------------------------
# 32-byte key, base64 encoded, for AES-256-GCM encryption of Shopify access
# tokens stored in `stores.access_token`. Generate: `openssl rand -base64 32`
ENCRYPTION_KEY="change-me-openssl-rand-base64-32"

# --- Shopify apps ----------------------------------------------------------
# Credentials live on each store, not here. A store is added in the backoffice
# (Stores -> Connect a store) together with the API key and secret key of the
# Shopify app it runs on, so any number of apps can be spread across stores
# without touching this file or redeploying.
#
# The two variables below are an OPTIONAL fallback, used only by stores that
# carry no keys of their own. Leave them unset on a fresh deployment.
# SHOPIFY_API_KEY="your-shopify-app-client-id"
# SHOPIFY_API_SECRET="your-shopify-app-client-secret"

# Defaults for a store that does not override them.
# Scopes requested during OAuth. Keep in sync with each app's configuration.
SHOPIFY_SCOPES="read_orders,write_orders,read_fulfillments,write_fulfillments"
# Admin API version used for REST + GraphQL calls.
SHOPIFY_API_VERSION="2025-07"

# --- Resend (transactional email, shared platform sending domain) ----------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Verified sender on the shared platform domain.
# The address customers see. Its domain must be verified in Resend (SPF+DKIM).
# A dedicated sending subdomain keeps this traffic's reputation separate from
# your root domain — verify `send.your-domain.com` rather than the apex.
RESEND_FROM_EMAIL="orders@send.your-domain.com"
# Fallback display name, used only when a store has no name of its own; the
# store's name is what customers normally see in front of the address.
RESEND_FROM_NAME="Tracky"
# Where replies land. Required in practice whenever the sending domain above
# has no MX records, which a dedicated sending subdomain usually does not —
# every template tells the customer to reply, so this must be a real inbox.
RESEND_REPLY_TO="support@your-domain.com"

# --- Upstash QStash (delayed email scheduling + the frequent sweep) --------
QSTASH_TOKEN="qstash-token"
QSTASH_CURRENT_SIGNING_KEY="sig_current"
QSTASH_NEXT_SIGNING_KEY="sig_next"
# How often the QStash schedule sweeps for undelivered email. Vercel's Hobby
# plan caps its own cron at once a day, so this is the real safety net.
# Re-run `npm run qstash:setup` after changing it.
# QSTASH_SWEEP_CRON="*/15 * * * *"

# --- Vercel Blob (logos, signed delivery-note photos) ----------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- The email sweep -------------------------------------------------------
# Shared secret checked by /api/cron/sweep-emails. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`, and `npm run qstash:setup` attaches it
# to the QStash schedule as well.
CRON_SECRET="change-me-random-string"

# --- Marketing site ------------------------------------------------------
# Where the public contact form delivers. Without it (or without Resend) the
# form refuses to pretend it sent anything and shows a fallback instead.
# CONTACT_EMAIL="hello@yourcompany.com"

# --- Platform operators --------------------------------------------------
# Comma-separated addresses granted the cross-store /platform console. These
# accounts can suspend stores, disconnect them from Shopify, disable accounts
# and grant this same access to others — every action audited. Keep the list
# short. It is also the way back in if the last flagged operator is removed.
#
# Access can also be granted per account with:
#   update users set is_platform_admin = true where email = '...';
# PLATFORM_ADMIN_EMAILS="you@yourcompany.com"
